{
  "name": "my-crx",
  "displayName": "my-crx",
  "version": "0.0.0",
  "author": "BluerAngala",
  "description": "基于create-chrome-ext 创建的快速开发浏览器扩展插件的模板。默认包含popup、sidepanel、options、contentScript、background、manifest.js",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "vue",
    "vite",
    "create-chrome-ext"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm format && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "fmt": "prettier --write '**/*.{vue,js,json,css,scss,md}'",
    "format": "pnpm lint && pnpm fmt",
    "zip": "pnpm build && node src/zip.js",
    "crx": "pnpm build && node scripts/build-crx.js",
    "pack": "pnpm build && node src/zip.js && node scripts/build-crx.js",
    "generate-logos": "node scripts/generate-logos.js"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "loglevel": "^1.9.2",
    "naive-ui": "^2.40.1",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.2.37",
    "vue-draggable-plus": "^0.6.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "crx3": "^1.1.3",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "gulp": "^5.0.0",
    "gulp-zip": "^6.0.0",
    "prettier": "^3.0.3",
    "prettier-plugin-vue": "^1.1.6",
    "sharp": "^0.33.0",
    "unocss": "^66.5.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.7"
  }
}
